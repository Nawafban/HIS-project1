<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>My Profile – HIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    .profile-hero{background:linear-gradient(135deg,#0a2540,#103a6e);padding:48px 0 80px;margin-bottom:-48px;}
    .profile-avatar{width:88px;height:88px;border-radius:50%;background:#00bcd4;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:2rem;font-weight:800;color:#fff;margin-bottom:16px;border:4px solid rgba(255,255,255,0.15);}
    .profile-hero h1{color:#fff;font-family:'Sora',sans-serif;font-size:1.8rem;font-weight:800;margin-bottom:6px;}
    .role-badge{display:inline-block;padding:4px 14px;border-radius:100px;font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;}
    .role-patient{background:rgba(0,200,150,0.2);color:#00c896;border:1px solid rgba(0,200,150,0.3);}
    .role-doctor{background:rgba(0,188,212,0.2);color:#00bcd4;border:1px solid rgba(0,188,212,0.3);}
    .role-staff{background:rgba(255,193,7,0.2);color:#ffc107;border:1px solid rgba(255,193,7,0.3);}
    .role-admin{background:rgba(239,83,80,0.2);color:#ef5350;border:1px solid rgba(239,83,80,0.3);}
    .profile-card{background:#fff;border-radius:16px;box-shadow:0 6px 24px rgba(10,37,64,0.10);padding:32px;margin-bottom:24px;}
    .profile-card h3{font-family:'Sora',sans-serif;font-size:1rem;font-weight:700;color:#0a2540;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid #d1dce8;}
    .info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;}
    .info-item label{font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:#5a7598;margin-bottom:4px;display:block;}
    .info-item span{font-size:0.95rem;color:#0a2540;font-weight:500;}
    .info-item span.empty{color:#8fa8c8;font-style:italic;}
    .quick-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px;}
    .action-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:0.88rem;font-weight:600;text-decoration:none;transition:all 0.2s;border:none;cursor:pointer;font-family:inherit;}
    .action-primary{background:#00bcd4;color:#fff;}
    .action-primary:hover{background:#0097a7;color:#fff;}
    .action-outline{background:transparent;color:#0a2540;border:1.5px solid #d1dce8;}
    .action-outline:hover{background:#f0f4f8;color:#0a2540;}
    .edit-form{display:none;margin-top:24px;padding-top:24px;border-top:1px solid #d1dce8;}
    .edit-form.open{display:block;}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
    .form-group label{display:block;font-size:0.8rem;font-weight:700;color:#5a7598;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.4px;}
    .form-group input{width:100%;padding:10px 14px;border:1.5px solid #d1dce8;border-radius:9px;font-size:0.92rem;font-family:inherit;color:#0a2540;outline:none;transition:border-color 0.2s;}
    .form-group input:focus{border-color:#00bcd4;box-shadow:0 0 0 3px rgba(0,188,212,0.1);}
    .success-box{background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:12px 16px;color:#2e7d32;font-size:0.88rem;margin-bottom:20px;display:flex;align-items:center;gap:8px;}
    .error-box{background:#fdecea;border:1px solid #f5c6cb;border-radius:10px;padding:12px 16px;color:#c0392b;font-size:0.88rem;margin-bottom:20px;}
  </style>
</head>
<body>
<%- include('partials/nav') %>

<div class="profile-hero">
  <div class="container">
    <div class="profile-avatar"><%= user.full_name.charAt(0).toUpperCase() %></div>
    <h1><%= user.full_name %></h1>
    <p style="color:rgba(255,255,255,0.6);margin-bottom:12px;"><%= user.email %></p>
    <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
  </div>
</div>

<section class="section" style="padding-top:72px;">
  <div class="container" style="max-width:900px;">

    <% if (success) { %>
    <div class="success-box">✅ <%= success %></div>
    <% } %>

    <!-- Account Info + Edit -->
    <div class="profile-card">
      <h3>👤 Account Information</h3>
      <div class="info-grid">
        <div class="info-item"><label>Full Name</label><span><%= user.full_name %></span></div>
        <div class="info-item"><label>Email</label><span><%= user.email %></span></div>
        <div class="info-item"><label>Role</label><span><%= user.role %></span></div>
        <div class="info-item"><label>Member Since</label><span><%= user.created_date ? new Date(user.created_date).toLocaleDateString() : '—' %></span></div>
        <div class="info-item"><label>Last Login</label><span><%= user.last_login ? new Date(user.last_login).toLocaleDateString() : '—' %></span></div>
      </div>

      <!-- Edit Form (all roles) -->
      <div class="edit-form" id="editForm">
        <form method="POST" action="/profile/edit">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="full_name" value="<%= user.full_name %>" required/>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" value="<%= user.email %>" required/>
            </div>
          </div>
          <div style="display:flex;gap:10px;">
            <button type="submit" class="action-btn action-primary">💾 Save Changes</button>
            <button type="button" class="action-btn action-outline" onclick="toggleEdit()">Cancel</button>
          </div>
        </form>
      </div>

      <div class="quick-actions">
        <button class="action-btn action-outline" onclick="toggleEdit()" id="editBtn">✏️ Edit Profile</button>
      </div>
    </div>

    <% if (extra) { %>
    <!-- Role-specific info -->
    <div class="profile-card">
      <% if (user.role === 'patient') { %>
      <h3>🧑‍⚕️ Patient Details</h3>
      <div class="info-grid">
        <div class="info-item"><label>Date of Birth</label><span><%= extra.date_of_birth || '—' %></span></div>
        <div class="info-item"><label>Gender</label><span><%= extra.gender || '—' %></span></div>
        <div class="info-item"><label>Blood Type</label><span><%= extra.blood_type || '—' %></span></div>
        <div class="info-item"><label>Phone</label><span><%= extra.contact_phone || '—' %></span></div>
        <div class="info-item"><label>Address</label><span><%= extra.address || '—' %></span></div>
        <div class="info-item"><label>Emergency Contact</label><span><%= extra.emergency_contact || '—' %></span></div>
        <div class="info-item"><label>Allergies</label><span class="<%= extra.allergies ? '' : 'empty' %>"><%= extra.allergies || 'None recorded' %></span></div>
        <div class="info-item"><label>Insurance Provider</label><span><%= extra.insurance_provider || '—' %></span></div>
        <div class="info-item"><label>Insurance Number</label><span><%= extra.insurance_number || '—' %></span></div>
      </div>
      <div class="quick-actions">
        <a href="/records/patient/<%= extra.patient_id %>" class="action-btn action-primary">📋 My Medical Records</a>
        <a href="/appointments" class="action-btn action-outline">📅 My Appointments</a>
      </div>
      <% } else if (user.role === 'doctor') { %>
      <h3>👨‍⚕️ Doctor Details</h3>
      <div class="info-grid">
        <div class="info-item"><label>Specialization</label><span><%= extra.specialization %></span></div>
        <div class="info-item"><label>License Number</label><span><%= extra.license_number %></span></div>
        <div class="info-item"><label>Hospital Affiliation</label><span><%= extra.hospital_affiliation %></span></div>
        <div class="info-item"><label>Contact Phone</label><span><%= extra.contact_phone %></span></div>
      </div>
      <div class="quick-actions">
        <a href="/appointments" class="action-btn action-primary">📅 View Appointments</a>
        <a href="/records" class="action-btn action-outline">📋 Medical Records</a>
      </div>
      <% } else if (user.role === 'staff') { %>
      <h3>🏥 Staff Details</h3>
      <div class="info-grid">
        <div class="info-item"><label>Department</label><span><%= extra.department %></span></div>
        <div class="info-item"><label>Job Title</label><span><%= extra.job_title %></span></div>
        <div class="info-item"><label>Contact Phone</label><span><%= extra.contact_phone %></span></div>
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- Admin quick access -->
    <% if (user.role === 'admin') { %>
    <div class="profile-card">
      <h3>⚙️ Admin Quick Access</h3>
      <div class="quick-actions">
        <a href="/users"        class="action-btn action-primary">👤 Manage Users</a>
        <a href="/patients"     class="action-btn action-outline">🧑‍⚕️ Patients</a>
        <a href="/doctors"      class="action-btn action-outline">👨‍⚕️ Doctors</a>
        <a href="/appointments" class="action-btn action-outline">📅 Appointments</a>
        <a href="/records"      class="action-btn action-outline">📋 Records</a>
      </div>
    </div>
    <% } %>

  </div>
</section>

<footer><p>© 2026 HIS – Hospital Information System</p></footer>
<script src="/js/main.js"></script>
<script>
  function toggleEdit() {
    const form = document.getElementById('editForm');
    const btn  = document.getElementById('editBtn');
    const open = form.classList.toggle('open');
    btn.textContent = open ? '✖ Cancel Edit' : '✏️ Edit Profile';
  }
  // Auto-open edit form if there was an error
  <% if (error) { %>toggleEdit();<% } %>
</script>
</body>
</html>
