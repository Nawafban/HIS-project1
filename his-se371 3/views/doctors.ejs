<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> – HIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%- include('partials/nav') %>

<div class="page-header">
  <div class="container" style="position:relative;z-index:1;">
    <h1>👨‍⚕️ Doctors</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <% if (success) { %><div class="alert alert-success">✅ <%= success %></div><% } %>
    <% if (error)   { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>

    <!-- ADD DOCTOR -->
    <div class="card" style="margin-bottom:32px;">
      <div class="form-section-title">Add New Doctor</div>
      <form action="/doctors" method="post" novalidate>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label>Full Name <span class="required">*</span></label>
            <input type="text" name="full_name" placeholder="Dr. Nora Al-Subaie" required />
          </div>
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" placeholder="dr.name@his.sa" required />
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label>Specialization <span class="required">*</span></label>
            <select name="specialization" required>
              <option value="">Select</option>
              <% ['Cardiology','Neurology','Pediatrics','Orthopedics','General','Dermatology','Oncology','Radiology','Surgery','Psychiatry'].forEach(s => { %>
                <option value="<%= s %>"><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>License Number <span class="required">*</span></label>
            <input type="text" name="license_number" placeholder="LIC-CARD-007" required />
          </div>
          <div class="form-group">
            <label>Contact Phone <span class="required">*</span></label>
            <input type="tel" name="contact_phone" placeholder="+966-11-111-0007" required />
          </div>
        </div>
        <div class="form-group">
          <label>Hospital Affiliation <span class="required">*</span></label>
          <input type="text" name="hospital_affiliation" placeholder="King Faisal Specialist Hospital" required />
        </div>
        <div style="text-align:right;">
          <button type="submit" class="btn btn-primary">➕ Add Doctor</button>
        </div>
      </form>
    </div>

    <!-- DOCTORS TABLE -->
    <div class="card">
      <div class="form-section-title" style="margin-bottom:20px;">All Doctors (<%= doctors.length %>)</div>
      <% if (!doctors.length) { %>
        <p class="text-muted text-center" style="padding:24px;">No doctors found.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>ID</th><th>Name</th><th>Specialization</th><th>License</th><th>Hospital</th><th>Phone</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% doctors.forEach(d => { %>
              <tr>
                <td><code><%= d.doctor_id %></code></td>
                <td><strong><%= d.full_name %></strong><br/><span style="font-size:0.8rem;color:var(--text-muted)"><%= d.email %></span></td>
                <td><span class="badge badge-resolved"><%= d.specialization %></span></td>
                <td style="font-size:0.85rem"><code><%= d.license_number %></code></td>
                <td style="font-size:0.85rem"><%= d.hospital_affiliation %></td>
                <td style="font-size:0.85rem"><%= d.contact_phone %></td>
                <td>
                  <div style="display:flex;gap:6px;">
                    <button onclick="toggleEdit('edit-<%= d.doctor_id %>')" class="btn btn-ghost btn-sm">Edit</button>
                    <form action="/doctors/<%= d.doctor_id %>?_method=DELETE" method="post">
                      <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete Dr. <%= d.full_name %>?">Del</button>
                    </form>
                  </div>
                </td>
              </tr>
              <tr id="edit-<%= d.doctor_id %>" style="display:none;background:var(--surface-2);">
                <td colspan="7" style="padding:20px;">
                  <form action="/doctors/<%= d.doctor_id %>?_method=PUT" method="post">
                    <div class="form-row form-row-2">
                      <div class="form-group">
                        <label>Specialization</label>
                        <select name="specialization">
                          <% ['Cardiology','Neurology','Pediatrics','Orthopedics','General','Dermatology','Oncology','Radiology','Surgery','Psychiatry'].forEach(s => { %>
                            <option value="<%= s %>" <%= d.specialization===s?'selected':'' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="form-group"><label>License Number</label><input type="text" name="license_number" value="<%= d.license_number %>" required /></div>
                    </div>
                    <div class="form-row form-row-2">
                      <div class="form-group"><label>Hospital Affiliation</label><input type="text" name="hospital_affiliation" value="<%= d.hospital_affiliation %>" required /></div>
                      <div class="form-group"><label>Contact Phone</label><input type="tel" name="contact_phone" value="<%= d.contact_phone %>" required /></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                    <button type="button" onclick="toggleEdit('edit-<%= d.doctor_id %>')" class="btn btn-ghost btn-sm">Cancel</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</section>

<footer><p>© 2026 HIS – CS340 · SE371 Course</p></footer>
<script src="/js/main.js"></script>
<script>function toggleEdit(id){const r=document.getElementById(id);r.style.display=r.style.display==='none'?'table-row':'none';}</script>
</body>
</html>
