<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> – HIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%- include('partials/nav') %>

<div class="page-header">
  <div class="container" style="position:relative;z-index:1;">
    <h1>🧑‍⚕️ Patients</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <% if (success) { %><div class="alert alert-success">✅ <%= success %></div><% } %>
    <% if (error)   { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>

    <!-- ADD PATIENT -->
    <div class="card mb-4" style="margin-bottom:32px;">
      <div class="form-section-title">Register New Patient</div>
      <form action="/patients" method="post" novalidate>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label>Full Name <span class="required">*</span></label>
            <input type="text" name="full_name" placeholder="Ahmed Al-Rashidi" required />
          </div>
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" placeholder="patient@mail.sa" required />
          </div>
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label>Date of Birth <span class="required">*</span></label>
            <input type="date" name="date_of_birth" required />
          </div>
          <div class="form-group">
            <label>Gender <span class="required">*</span></label>
            <select name="gender" required>
              <option value="">Select</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
          <div class="form-group">
            <label>Blood Type <span class="required">*</span></label>
            <select name="blood_type" required>
              <option value="">Select</option>
              <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bt => { %>
                <option value="<%= bt %>"><%= bt %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label>Contact Phone <span class="required">*</span></label>
            <input type="tel" name="contact_phone" placeholder="+966-50-000-0000" required />
          </div>
          <div class="form-group">
            <label>Emergency Contact <span class="required">*</span></label>
            <input type="text" name="emergency_contact" placeholder="Name +966-50-000-0000" required />
          </div>
        </div>
        <div class="form-group">
          <label>Address <span class="required">*</span></label>
          <input type="text" name="address" placeholder="Riyadh, Al-Olaya" required />
        </div>
        <div class="form-row form-row-3">
          <div class="form-group">
            <label>Allergies</label>
            <input type="text" name="allergies" placeholder="e.g. Penicillin (or leave blank)" />
          </div>
          <div class="form-group">
            <label>Insurance Provider</label>
            <input type="text" name="insurance_provider" placeholder="Bupa Arabia" />
          </div>
          <div class="form-group">
            <label>Insurance Number</label>
            <input type="text" name="insurance_number" placeholder="INS-001" />
          </div>
        </div>
        <div style="text-align:right;">
          <button type="submit" class="btn btn-primary">➕ Register Patient</button>
        </div>
      </form>
    </div>

    <!-- PATIENTS TABLE -->
    <div class="card">
      <div class="flex justify-between items-center mb-4">
        <div class="form-section-title" style="margin:0;border:none;padding:0;">
          All Patients <span style="font-size:0.85rem;font-weight:400;color:var(--text-muted)">(<%= patients.length %>)</span>
        </div>
      </div>
      <% if (!patients.length) { %>
        <p class="text-muted text-center" style="padding:24px;">No patients found.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>ID</th><th>Name</th><th>DOB</th><th>Gender</th><th>Blood</th><th>Phone</th><th>Allergies</th><th>Insurance</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% patients.forEach(p => { %>
              <tr>
                <td><code><%= p.patient_id %></code></td>
                <td><strong><%= p.full_name %></strong><br/><span style="font-size:0.8rem;color:var(--text-muted)"><%= p.email %></span></td>
                <td style="white-space:nowrap"><%= p.date_of_birth ? new Date(p.date_of_birth).toLocaleDateString('en-SA') : '' %></td>
                <td style="text-transform:capitalize"><%= p.gender %></td>
                <td><span class="badge badge-open" style="background:rgba(0,188,212,0.1);color:var(--accent-dark)"><%= p.blood_type %></span></td>
                <td style="font-size:0.88rem"><%= p.contact_phone %></td>
                <td style="font-size:0.85rem"><%= p.allergies || '—' %></td>
                <td style="font-size:0.85rem"><%= p.insurance_provider || '—' %></td>
                <td>
                  <div style="display:flex;gap:6px;flex-wrap:nowrap;">
                    <!-- Edit inline form toggle -->
                    <a href="/records/patient/<%= p.patient_id %>" class="btn btn-ghost btn-sm">📋 Records</a>
                    <button onclick="toggleEdit('edit-<%= p.patient_id %>')" class="btn btn-ghost btn-sm">Edit</button>
                    <form action="/patients/<%= p.patient_id %>?_method=DELETE" method="post">
                      <button type="submit" class="btn btn-danger btn-sm"
                        data-confirm="Delete patient <%= p.full_name %>?">Del</button>
                    </form>
                  </div>
                </td>
              </tr>
              <!-- Inline edit row -->
              <tr id="edit-<%= p.patient_id %>" style="display:none;background:var(--surface-2);">
                <td colspan="9" style="padding:20px;">
                  <form action="/patients/<%= p.patient_id %>?_method=PUT" method="post">
                    <div class="form-row form-row-3">
                      <div class="form-group"><label>Phone</label><input type="tel" name="contact_phone" value="<%= p.contact_phone %>" required /></div>
                      <div class="form-group"><label>Blood Type</label>
                        <select name="blood_type">
                          <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bt => { %>
                            <option value="<%= bt %>" <%= p.blood_type===bt?'selected':'' %>><%= bt %></option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="form-group"><label>Allergies</label><input type="text" name="allergies" value="<%= p.allergies||'' %>" /></div>
                    </div>
                    <div class="form-row form-row-2">
                      <div class="form-group"><label>Address</label><input type="text" name="address" value="<%= p.address %>" required /></div>
                      <div class="form-group"><label>Emergency Contact</label><input type="text" name="emergency_contact" value="<%= p.emergency_contact %>" required /></div>
                    </div>
                    <div class="form-row form-row-2">
                      <div class="form-group"><label>Insurance Provider</label><input type="text" name="insurance_provider" value="<%= p.insurance_provider||'' %>" /></div>
                      <div class="form-group"><label>Insurance Number</label><input type="text" name="insurance_number" value="<%= p.insurance_number||'' %>" /></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                    <button type="button" onclick="toggleEdit('edit-<%= p.patient_id %>')" class="btn btn-ghost btn-sm">Cancel</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</section>

<footer><p>© 2026 HIS – CS340 · SE371 Course</p></footer>
<script src="/js/main.js"></script>
<script>
  function toggleEdit(id) {
    const row = document.getElementById(id);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
  }
</script>
</body>
</html>
